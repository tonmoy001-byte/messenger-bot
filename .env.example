# ─────────────────────────────────────────────────────────
#  Cyberbot — Environment Variables Template
# ─────────────────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# ─── DATABASE (SUPABASE / POSTGRESQL) - REQUIRED ─────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ─── AI ENGINE (GROQ PRIMARY, GEMINI FALLBACK) ────────────
# AI_PROVIDER can be "groq" or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen-2.5-72b
GEMINI_API_KEY=
# Alternative: GOOGLE_AI_API_KEY=

# ─── FACEBOOK MESSENGER (OPTIONAL IN DEV, ENFORCED IN PROD) ──
# Choose ANY strong secret string - must match FB Developer Dashboard Webhook config
VERIFY_TOKEN=
MESSENGER_VERIFY_TOKEN=
PAGE_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=

# ─── WHATSAPP (META CLOUD API) ────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── INSTAGRAM (OPTIONAL) ────────────────────────────────
INSTAGRAM_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# ─── META OAUTH (OPTIONAL) ───────────────────────────────
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# ─── QUEUE (REDIS / BULLMQ) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RAG VECTOR DB (OPTIONAL) ────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=

# ─── SECURITY - REQUIRED (App will crash if missing or weak) ─
# Must be a strong, unique secret key (minimum 16 characters)
JWT_SECRET=
# Must be exactly 32 characters long for AES-256-GCM encryption
TOKEN_ENCRYPTION_KEY=
# Shared secret for internal service calls to POST /api/orders/from-ai
# Send as header: X-Internal-Order-Secret: <value>
# Prefer in-process createOrderSafe or admin JWT; set this if anything calls the HTTP endpoint.
INTERNAL_ORDER_SECRET=

# ─── CORS ALLOW-LIST ──────────────────────────────────────
# Comma-separated list of allowed origin domains (e.g., http://localhost:3000,https://my-app.com)
ALLOWED_ORIGINS=

# ─── WEB CHAT TENANT (PUBLIC WIDGET) ──────────────────────
# Widget must send tenant on every /api/chat request:
#   body.tenant / body.tenant_id  OR  headers X-Tenant-Slug / X-Tenant-ID
# Optional non-production fallback when the widget omits tenant:
# DEFAULT_TENANT_ID=
# DEFAULT_TENANT_SLUG=

# ─── ADMIN BOOTSTRAPPING ──────────────────────────────────
# Enable default admin creation (only allowed in non-production, or if BOOTSTRAP_ADMIN=true)
BOOTSTRAP_ADMIN=false
ADMIN_PASSWORD=

# ─── PAYMENTS (OPTIONAL) ──────────────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_BASE_URL=https://sandbox.nagad.com.bd
