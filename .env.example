# ─────────────────────────────────────────────────────────
#  Cyberbot — Environment Variables
# ─────────────────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# ─── DATABASE (SUPABASE / POSTGRESQL) ─────────────────────
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# ─── AI ENGINE (GROQ PRIMARY, GEMINI FALLBACK) ────────────
# "groq" or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen-2.5-72b
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: GOOGLE_AI_API_KEY=your_gemini_api_key_here

# ─── FACEBOOK MESSENGER ───────────────────────────────────
# Choose ANY secret string — must match FB Developer Dashboard
VERIFY_TOKEN=my_secret_verify_token_123
MESSENGER_VERIFY_TOKEN=my_secret_verify_token_123
# From: Facebook Developer App > Messenger > Settings > Generate Token
PAGE_ACCESS_TOKEN=your_page_access_token_here
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# ─── WHATSAPP (META CLOUD API) ────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# ─── INSTAGRAM (OPTIONAL) ────────────────────────────────
INSTAGRAM_TOKEN=your_instagram_access_token_here
INSTAGRAM_VERIFY_TOKEN=your_instagram_webhook_verify_token_here

# ─── META OAUTH (OPTIONAL) ───────────────────────────────
META_REDIRECT_URI=http://your-ngrok-url.ngrok-free.dev/api/auth/meta/callback

# ─── QUEUE (REDIS / BULLMQ) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RAG VECTOR DB (OPTIONAL) ────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_index_name

# ─── SECURITY ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key
TOKEN_ENCRYPTION_KEY=your_32_char_encryption_key_here

# ─── ADMIN ────────────────────────────────────────────────
ADMIN_PASSWORD=admin123

# ─── PAYMENTS (OPTIONAL) ──────────────────────────────────
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=your_bkash_base_url
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_NUMBER=your_nagad_merchant_number
NAGAD_BASE_URL=your_nagad_base_url