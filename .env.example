# ─────────────────────────────────────────────────────────
#  Facebook Messenger Bot — Environment Variables
# ─────────────────────────────────────────────────────────

# Choose ANY secret string — must match what you enter in FB Developer Dashboard
VERIFY_TOKEN=my_secret_verify_token_123

# From: Facebook Developer App > Messenger > Settings > Generate Token
PAGE_ACCESS_TOKEN=your_page_access_token_here

# From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: GOOGLE_AI_API_KEY=your_gemini_api_key_here

# ─── WHATSAPP (META CLOUD API) ──────────────────────────
# From: Meta Developer Dashboard > WhatsApp > Setup
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here

# ─── INSTAGRAM (OPTIONAL) ────────────────────────────────
INSTAGRAM_TOKEN=your_instagram_access_token_here
INSTAGRAM_VERIFY_TOKEN=your_instagram_webhook_verify_token_here

# ─── META OAUTH (OPTIONAL) ───────────────────────────────
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# ─── DATABASE ─────────────────────────────────────────────
MONGODB_URI=your_mongodb_connection_string

# ─── SECURITY ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key
TOKEN_ENCRYPTION_KEY=your_32_char_encryption_key_here

# ─── ADMIN ────────────────────────────────────────────────
ADMIN_PASSWORD=admin123

# ─── PINECONE (OPTIONAL - for RAG) ───────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_index_name

# Server port (default: 3000)
PORT=3000
